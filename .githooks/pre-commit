#!/bin/bash
# Pre-commit hook — runs deterministic CI tooling against staged changes.
# Replaces LLM-orchestrated check invocations with mechanical structural enforcement.
#
# CANONICAL SOURCE. This file (.githooks/pre-commit) IS the hook git runs —
# core.hooksPath=.githooks, and it is TRACKED, so every clone gets it with NO install
# step. Edit THIS file directly. (Consolidated at .E.0.1: the prior tools/hooks/pre-commit
# + install-git-hooks.sh -> .git/hooks/ pattern was DEAD — because core.hooksPath points
# here, git never executed the installed copy, so Checks A-F had silently not run on real
# commits. That pattern is retired; .githooks/ is the one canonical, tracked, portable hook.)
#
# Codified incrementally:
#  - Check A (B-Plus, plan body symbol existence)    at v5.15.5.F.4d.1.B.4 v1.7.4
#  - Check B (Check 11, forward-promise auto-write)   at v5.15.5.F.4d.1.D    Phase F.1
#  - Check C (doc-rename classification)              at v5.15.5.F.4d.1.D.1  Phase A.3
#  - Check E (doc-floor: bidirectional memories + capture-audit-mechanical) at v5.15.5.F.4d.1.E Session-4 (D-112/D-115)
#  - Check D (plan body Tests-changed section)        at v5.15.5.F.4d.1.D.1  Phase A.6
#  - Check F (determinism net: FP golden + locale guard + replay-locale)    at v5.15.5.F.4d.1.E.0.1
#  - Check G (doc-system frontmatter on changed .md; folded from legacy hook) at v5.15.5.F.4d.1.E.0.1
#  - Check N (latency-path conformance: static ASM instr-budget + H4/H7/H20/H1/H2 gate) at v5.15.5.F.4d.1.E.1.0
#
# Bypass via env vars (use sparingly):
#   SKIP_PLAN_BODY_CHECK=1     — bypass Check A (B-Plus)
#   SKIP_CHECK_11=1            — bypass Check B (forward-promise)
#   SKIP_DOC_RENAME_CHECK=1    — bypass Check C (doc-rename classification)
#   SKIP_DOC_FLOOR_CHECK=1     — bypass Check E (doc-floor: bidirectional memories + capture-audit-mechanical)
#   SKIP_TESTS_SECTION_CHECK=1 — bypass Check D (Tests-changed section)
#   SKIP_DETERMINISM_CHECK=1   — bypass Check F (determinism net)
#   SKIP_DOC_METADATA_CHECK=1  — bypass Check G (doc frontmatter on changed .md)
#   SKIP_LATENCY_CONFORMANCE_CHECK=1 — bypass Check N (latency-path conformance)
#   SKIP_ALL_CHECKS=1          — bypass all

if [ "${SKIP_ALL_CHECKS:-0}" = "1" ]; then
    echo "[pre-commit] SKIP_ALL_CHECKS=1 set; skipping all CI checks"
    exit 0
fi

# .E.0.1 hang-class close (sister to the 74bd77b rg-path fix): a git hook runs DETACHED, so any
# stdin-reading child — a path-less `rg`/`grep`, an interactive prompt — blocks the COMMIT forever at
# 0% CPU. Redirect the whole hook's stdin to /dev/null: every check it spawns inherits it and gets
# instant EOF. Structural close for the entire commit-time suite, independent of any one script's rg paths.
exec </dev/null

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"  # .E.0.1: machine-portable, zero hardcoded path (git runs the hook from the repo root)
OVERALL_FAIL=0

# ============================================================================
# CHECK A: B-Plus (plan body symbol existence) — Class 14 fabrication detection
# Codified at .B.4 v1.7.4 per M6 + structural-enforcement-when-memory-insufficient (M7).
# ============================================================================
if [ "${SKIP_PLAN_BODY_CHECK:-0}" != "1" ]; then
    B_PLUS_TOOL="${REPO_ROOT}/tools/check_plan_body_symbol_existence.py"
    if [ -f "$B_PLUS_TOOL" ]; then
        STAGED_PLANS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^plans/.*\.md$|.*subplans/.*\.md$|.*MASTER\.md$' || true)
        if [ -n "$STAGED_PLANS" ]; then
            echo "[pre-commit] B-Plus: verifying plan body symbol existence for staged plan(s):"
            echo "$STAGED_PLANS" | sed 's/^/  - /'
            ANY_FAB=0
            for plan in $STAGED_PLANS; do
                if [ -L "$plan" ]; then
                    plan=$(readlink -f "$plan")
                fi
                if [ ! -f "$plan" ]; then
                    continue
                fi
                if ! python3 "$B_PLUS_TOOL" "$plan" 2>&1 | tee /tmp/plan_body_check_$$.log; then
                    ANY_FAB=1
                fi
            done
            rm -f /tmp/plan_body_check_$$.log
            if [ "$ANY_FAB" = "1" ]; then
                echo ""
                echo "[pre-commit] B-Plus FAIL: fabrication(s) detected in plan body code samples (Class 14)."
                echo "[pre-commit] Fix fabricated symbol citations OR bypass with SKIP_PLAN_BODY_CHECK=1"
                OVERALL_FAIL=1
            else
                echo "[pre-commit] B-Plus PASS"
            fi
        fi
    fi
else
    echo "[pre-commit] SKIP_PLAN_BODY_CHECK=1; skipping B-Plus"
fi

# ============================================================================
# CHECK B: Check 11 (forward-promise auto-write verification) — M7 7th canonical
# Codified at .D Phase F.1 per deterministic skill-tool integration directive.
# ============================================================================
if [ "${SKIP_CHECK_11:-0}" != "1" ]; then
    FWD_TOOL="${REPO_ROOT}/tools/check_forward_promise_audit.py"
    if [ -f "$FWD_TOOL" ]; then
        STAGED_CLAIMS=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'CHANGELOG\.md$|postmortems/.*\.md$|handoffs/.*\.md$|subplans/.*\.md$|recurring-bug-patterns/.*\.md$|tech-debt/.*\.md$|PARITY_ISSUES\.md$' || true)
        if [ -n "$STAGED_CLAIMS" ]; then
            echo "[pre-commit] Check 11: forward-promise verification on staged forward-promise surface(s):"
            echo "$STAGED_CLAIMS" | sed 's/^/  - /'
            if ! python3 "$FWD_TOOL" --strict --since HEAD~5 2>&1; then
                echo ""
                echo "[pre-commit] Check 11 FAIL: forward-promise drift detected in staged files."
                echo "[pre-commit] Fix the drift (write missing ledger entries OR resolve claim) OR bypass with SKIP_CHECK_11=1"
                OVERALL_FAIL=1
            else
                echo "[pre-commit] Check 11 PASS"
            fi
        fi
    fi
else
    echo "[pre-commit] SKIP_CHECK_11=1; skipping Check 11"
fi

# ============================================================================
# CHECK C: Doc-rename classification — .D.1 doc-sweep terminology drift detection
# Codified at .D.1 Phase A.3. Flags per-core terminology drift introduced post-.D.1
# in staged DOCS/ DESIGN_SPECS/ plans/ .md files. Strict mode fails on unclassified hits.
# ============================================================================
if [ "${SKIP_DOC_RENAME_CHECK:-0}" != "1" ]; then
    DOC_RENAME_TOOL="${REPO_ROOT}/tools/check_doc_rename_classification.py"
    if [ -f "$DOC_RENAME_TOOL" ]; then
        STAGED_DOCS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^DOCS/.*\.md$|^DESIGN_SPECS/.*\.md$|^plans/.*\.md$|^CLAUDE\.md$|^CLAUDE\.local\.md$' || true)
        if [ -n "$STAGED_DOCS" ]; then
            echo "[pre-commit] Doc-rename: classifying terminology in staged doc(s):"
            echo "$STAGED_DOCS" | sed 's/^/  - /'
            # Scope tool to staged files only; --strict fails on unclassified (ambiguous) hits
            if ! python3 "$DOC_RENAME_TOOL" --scope $STAGED_DOCS --strict --summary-only 2>&1; then
                echo ""
                echo "[pre-commit] Doc-rename FAIL: unclassified terminology hit(s) in staged docs."
                echo "[pre-commit] Review classification OR bypass with SKIP_DOC_RENAME_CHECK=1"
                OVERALL_FAIL=1
            else
                echo "[pre-commit] Doc-rename PASS"
            fi
        fi
    fi
else
    echo "[pre-commit] SKIP_DOC_RENAME_CHECK=1; skipping doc-rename classification"
fi

# ============================================================================
# CHECK D: Plan body Tests-changed section — landed at .D.1 Phase A.6.
# (Tool tools/check_plan_body_tests_section.py created at .D.1 Phase A.5; this block
#  is a NO-OP until that tool is present — guarded on tool existence. Once A.5 lands
#  the tool, this check activates automatically with no further hook edit needed.)
# ============================================================================
if [ "${SKIP_TESTS_SECTION_CHECK:-0}" != "1" ]; then
    TESTS_SECTION_TOOL="${REPO_ROOT}/tools/check_plan_body_tests_section.py"
    if [ -f "$TESTS_SECTION_TOOL" ]; then
        STAGED_PLANS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^plans/.*subplans/.*\.md$' || true)
        if [ -n "$STAGED_PLANS" ]; then
            echo "[pre-commit] Tests-section: verifying Tests-changed enumeration for staged plan(s):"
            echo "$STAGED_PLANS" | sed 's/^/  - /'
            ANY_VIOLATION=0
            for plan in $STAGED_PLANS; do
                if [ -L "$plan" ]; then
                    plan=$(readlink -f "$plan")
                fi
                if [ ! -f "$plan" ]; then
                    continue
                fi
                if ! python3 "$TESTS_SECTION_TOOL" --plan-body "$plan" --strict 2>&1; then
                    ANY_VIOLATION=1
                fi
            done
            if [ "$ANY_VIOLATION" = "1" ]; then
                echo ""
                echo "[pre-commit] Tests-section FAIL: plan body touches tests/ but lacks complete Tests-changed section."
                echo "[pre-commit] Add the section (3 sub-categories) OR bypass with SKIP_TESTS_SECTION_CHECK=1"
                OVERALL_FAIL=1
            else
                echo "[pre-commit] Tests-section PASS"
            fi
        fi
    fi
else
    echo "[pre-commit] SKIP_TESTS_SECTION_CHECK=1; skipping Tests-section check"
fi

# ============================================================================
# CHECK E: doc/plan mechanical floor (bidirectional memories + capture-audit-mechanical)
# Codified at .E Session-4 (D-112/D-115). Closes the gap where a one-way memory
# sister-link / orphan memory / unindexed skill could slip through a commit:
# Checks A-D cover plan-body symbols + forward-promise + doc-rename + tests-section,
# but NOT memory bidirectionality or index-sync. The two mechanizing tools
# (check_doc_metadata --bidirectional --memories + check_capture_audit) are the
# HARD half of check_session_docs.sh; fire them when a memory / skill / index doc is staged.
# ============================================================================
if [ "${SKIP_DOC_FLOOR_CHECK:-0}" != "1" ]; then
    STAGED_DOCFLOOR=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'MEMORY\.md$|memory/.*\.md$|memory\.backup/.*\.md$|claude-skills/.*SKILL\.md$|CLAUDE\.md$|CLAUDE\.local\.md$|decision-logs/.*\.md$' || true)
    if [ -n "$STAGED_DOCFLOOR" ]; then
        echo "[pre-commit] Doc-floor: bidirectional-memories + capture-audit-mechanical (staged doc/skill/memory change):"
        DOCFLOOR_FAIL=0
        BIDIR_TOOL="${REPO_ROOT}/tools/check_doc_metadata.py"
        CAPA_TOOL="${REPO_ROOT}/tools/check_capture_audit.py"
        if [ -f "$BIDIR_TOOL" ]; then
            # .E.0.1: capture rc explicitly — a 'cmd | tail' pipe would mask the tool's exit (pipe status = tail's).
            BIDIR_OUT=$(python3 "$BIDIR_TOOL" --bidirectional --memories 2>&1); BIDIR_RC=$?
            echo "$BIDIR_OUT" | tail -5
            [ "$BIDIR_RC" -ne 0 ] && DOCFLOOR_FAIL=1
        fi
        if [ -f "$CAPA_TOOL" ]; then
            if ! python3 "$CAPA_TOOL" --quiet 2>&1; then DOCFLOOR_FAIL=1; fi
        fi
        if [ "$DOCFLOOR_FAIL" = "1" ]; then
            echo "[pre-commit] Doc-floor FAIL: one-way sister / orphan memory / unindexed skill / unmatched sentinel."
            echo "[pre-commit] Fix the drift OR bypass with SKIP_DOC_FLOOR_CHECK=1"
            OVERALL_FAIL=1
        else
            echo "[pre-commit] Doc-floor PASS"
        fi
    fi
else
    echo "[pre-commit] SKIP_DOC_FLOOR_CHECK=1; skipping doc-floor check"
fi

# ============================================================================
# CHECK F: determinism net (FP golden + locale guard + replay-locale gate)
# Codified at .E.0.1 — the standing net #11 (FixedPoint<RADIX,FRAC>) + .E.1 run under.
# Scoped to FP / parse / locale / recorder paths so unrelated commits stay fast.
# Robust rc-capture (NOT `cmd | tail`, which would mask the tool's exit).
# ============================================================================
if [ "${SKIP_DETERMINISM_CHECK:-0}" != "1" ]; then
    DET_TOOL="$REPO_ROOT/tools/check_determinism.sh"
    STAGED_DET=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(FixedPoint/|Backtest/BacktestEngine\.hpp|DataStream/(DepthReplayState|TickRecorder|DepthRecorder)\.hpp|CoreFrameworks/ParseFast\.hpp|main\.cpp|foxml_suite\.cpp|tools/(compare_scalers|fp_determinism_golden|replay_locale_gate)\.|GUI/(GuiThread|StrategyQualityPanel)\.hpp|tools/check_(fp_determinism|locale_determinism|determinism)\.sh|ML_Headers/(RidgeBlender|BanditLearning)\.hpp|tools/(check_h10_simd_determinism\.sh|h10_kernel_harness\.cpp))' || true)
    if [ -n "$STAGED_DET" ] && [ -x "$DET_TOOL" ]; then
        echo "[pre-commit] Check F: determinism net (staged FP/parse/locale change detected)"
        DET_OUT=$("$DET_TOOL" 2>&1); DET_RC=$?
        echo "$DET_OUT" | tail -20
        if [ "$DET_RC" -ne 0 ]; then
            echo "[pre-commit] Check F FAIL: determinism net violation (FP golden drift / stray setlocale / new raw parse / replay-locale)."
            echo "[pre-commit] Fix the drift — or, if this is a DELIBERATE epoch transition, regenerate the golden — OR bypass with SKIP_DETERMINISM_CHECK=1"
            OVERALL_FAIL=1
        else
            echo "[pre-commit] Check F PASS"
        fi
    fi
else
    echo "[pre-commit] SKIP_DETERMINISM_CHECK=1; skipping determinism net"
fi

# ============================================================================
# CHECK M: hot-path/structural grep-CI invariants (.E.1.0 §4d) — H14 no-C++-bitfield
# (+ H7/H20 advisory next). Calls check_h14 directly now; an aggregator script lands
# when H7/H20 joins (≥2 gates justify it — avoid premature abstraction). Scoped to
# staged engine source so unrelated commits stay fast.
# ============================================================================
if [ "${SKIP_HOT_PATH_INVARIANTS_CHECK:-0}" != "1" ]; then
    H14_TOOL="$REPO_ROOT/tools/check_h14_no_bitfield.py"
    STAGED_HPI=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(CoreFrameworks/|Strategies/|MemHeaders/|ML_Headers/|FixedPoint/|DataStream/|GUI/|Backtest/).*\.(hpp|cpp|h|inl)$' || true)
    if [ -n "$STAGED_HPI" ] && [ -f "$H14_TOOL" ]; then
        echo "[pre-commit] Check M: hot-path/structural grep-CI — H14 no-bitfield (staged engine source detected)"
        HPI_OUT=$(python3 "$H14_TOOL" 2>&1); HPI_RC=$?
        echo "$HPI_OUT" | tail -15
        if [ "$HPI_RC" -ne 0 ]; then
            echo "[pre-commit] Check M FAIL: a hot-path/structural grep-CI invariant failed (H14 C++ bitfield — use MBS_*/BITMAP_* over uintN_t)."
            echo "[pre-commit] Fix it — or bypass with SKIP_HOT_PATH_INVARIANTS_CHECK=1"
            OVERALL_FAIL=1
        else
            echo "[pre-commit] Check M PASS"
        fi
    fi
else
    echo "[pre-commit] SKIP_HOT_PATH_INVARIANTS_CHECK=1; skipping hot-path invariants grep-CI"
fi

# ============================================================================
# CHECK N: latency-path conformance (.E.1.0 H8) — static ASM instruction-budget + branch-class
# (the H7/H20 meter; SUBSUMES the H7/H20 grep per D-234) + H4-float/div/forbidden/indirect/un-analyzed
# over the PRODUCTION disassembly of the manifested hot/slow KERNELS, against the grandfathered baseline
# (tools/lib/latency_path_budgets.json). Scoped to staged latency-path source / tool / baseline.
# ============================================================================
if [ "${SKIP_LATENCY_CONFORMANCE_CHECK:-0}" != "1" ]; then
    LPC_TOOL="$REPO_ROOT/tools/check_latency_path_conformance.py"
    STAGED_LPC=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(CoreFrameworks/(ExecutionCore|GateParameters)\.hpp|ML_Headers/(RollingStats|RidgeBlender|ConfidenceScore)\.hpp|Strategies/RegimeDetector\.hpp|FixedPoint/FixedPointN\.hpp|tools/(check_latency_path_conformance\.py|lib/latency_path_budgets\.json))' || true)
    if [ -n "$STAGED_LPC" ] && [ -f "$LPC_TOOL" ]; then
        echo "[pre-commit] Check N: latency-path conformance (staged hot/slow-kernel or tool/baseline change detected)"
        LPC_OUT=$(python3 "$LPC_TOOL" 2>&1); LPC_RC=$?
        echo "$LPC_OUT" | tail -25
        if [ "$LPC_RC" -ne 0 ]; then
            echo "[pre-commit] Check N FAIL: a latency-path HARD invariant (H4 float / div / forbidden-call / indirect / un-analyzed) OR the instruction/branch ratchet was violated."
            echo "[pre-commit]   Fix it — or, if a kernel intentionally grew, re-baseline (python3 tools/check_latency_path_conformance.py --update-budgets) — OR bypass with SKIP_LATENCY_CONFORMANCE_CHECK=1"
            OVERALL_FAIL=1
        else
            echo "[pre-commit] Check N PASS"
        fi
    fi
else
    echo "[pre-commit] SKIP_LATENCY_CONFORMANCE_CHECK=1; skipping latency-path conformance"
fi

# ============================================================================
# CHECK L: P&L gross single-source (D-190 / M7) — the realized + unrealized price-diff gross
# (renamed from a duplicate "CHECK G" — that label belongs to the doc-frontmatter check below)
# MUST route through Money_FillGross (Portfolio.hpp); a re-introduced 2-mul form
# (round(exit*qty)-round(entry*qty)) diverges from the 1-mul books by 1 ULP under decimal
# (PARITY-038, Landmine 8). Scoped to money-path accounting headers so unrelated commits stay fast.
# ============================================================================
if [ "${SKIP_GROSS_SSOT_CHECK:-0}" != "1" ]; then
    GROSS_TOOL="$REPO_ROOT/tools/check_money_gross_single_source.py"
    STAGED_GROSS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(CoreFrameworks/(Portfolio|ControllerEventLoop|OrderManager)\.hpp|Strategies/|Backtest/)' || true)
    if [ -n "$STAGED_GROSS" ] && [ -f "$GROSS_TOOL" ]; then
        echo "[pre-commit] Check L: P&L gross single-source (staged accounting-path change detected)"
        GROSS_OUT=$(python3 "$GROSS_TOOL" 2>&1); GROSS_RC=$?
        echo "$GROSS_OUT" | tail -10
        if [ "$GROSS_RC" -ne 0 ]; then
            echo "[pre-commit] Check L FAIL: open-coded 2-mul P&L gross — use Money_FillGross (PARITY-038 / D-190 / Landmine 8)."
            echo "[pre-commit] Fix it — or bypass with SKIP_GROSS_SSOT_CHECK=1"
            OVERALL_FAIL=1
        else
            echo "[pre-commit] Check L PASS"
        fi
    fi
else
    echo "[pre-commit] SKIP_GROSS_SSOT_CHECK=1; skipping P&L gross single-source check"
fi

# ============================================================================
# CHECK G: doc-system frontmatter on changed .md (folded from the legacy .githooks/
# hook at the .E.0.1 consolidation — preserves the per-commit frontmatter validation
# that was the ONLY check git actually ran before this consolidation).
# ============================================================================
if [ "${SKIP_DOC_METADATA_CHECK:-0}" != "1" ]; then
    DM_TOOL="${REPO_ROOT}/tools/check_doc_metadata.py"
    CHANGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.md$' || true)
    DM_PATHS=""
    for f in $CHANGED_MD; do
        if [ -L "$f" ]; then DM_PATHS="$DM_PATHS $(readlink -f "$f")"
        elif [[ "$f" == DOCS/* ]] || [[ "$f" == CLAUDE* ]]; then DM_PATHS="$DM_PATHS ${REPO_ROOT}/$f"; fi
    done
    if [ -n "$DM_PATHS" ] && [ -f "$DM_TOOL" ]; then
        echo "[pre-commit] Check G: doc-system frontmatter on changed .md"
        if ! python3 "$DM_TOOL" --paths $DM_PATHS; then
            echo "[pre-commit] Check G FAIL: doc-system frontmatter violations."
            echo "[pre-commit] Fix the frontmatter OR bypass with SKIP_DOC_METADATA_CHECK=1"
            OVERALL_FAIL=1
        else
            echo "[pre-commit] Check G PASS"
        fi
    fi
else
    echo "[pre-commit] SKIP_DOC_METADATA_CHECK=1; skipping doc-metadata check"
fi

# ============================================================================
# CHECK H: identifier-retirement (tombstone guard — Knight-Capital defense, H21)
# Persistence/wire-visible identifiers (snapshot/format VERSIONs + persisted enum CODES)
# are append-only + immutable; a renumber / value-reuse / silent-drop is a Power-Peg-class
# reactivation risk (old state/messages/un-updated nodes carry the old meaning). Golden
# ledger: tools/identifier_ledger.txt. Fires when a registry/version-bearing source is staged
# (the enrolled dirs auto-cover future enrollment; the tool is cheap).
# Spec: DESIGN_SPECS/meta-disciplines/dead-code-and-identifier-retirement-discipline.md
# ============================================================================
if [ "${SKIP_IDENTIFIER_CHECK:-0}" != "1" ]; then
    ID_TOOL="${REPO_ROOT}/tools/check_identifier_retirement.py"
    STAGED_ID=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(CoreFrameworks/|ML_Headers/|Strategies/|MemHeaders/|tools/(identifier_ledger\.txt|check_identifier_retirement\.py))' || true)
    if [ -n "$STAGED_ID" ] && [ -f "$ID_TOOL" ]; then
        echo "[pre-commit] Check H: identifier-retirement (tombstone guard; staged registry/version change)"
        ID_OUT=$(python3 "$ID_TOOL" 2>&1); ID_RC=$?
        echo "$ID_OUT" | tail -12
        if [ "$ID_RC" -ne 0 ]; then
            echo "[pre-commit] Check H FAIL: a persisted/wire identifier was renumbered/reused/dropped (Knight-Capital reuse)."
            echo "[pre-commit] Tombstone the slot (never reassign the number) — or, if this is an intentional ADD/version-bump,"
            echo "[pre-commit]   re-run: python3 tools/check_identifier_retirement.py --update — OR bypass with SKIP_IDENTIFIER_CHECK=1"
            OVERALL_FAIL=1
        else
            echo "[pre-commit] Check H PASS"
        fi
    fi
else
    echo "[pre-commit] SKIP_IDENTIFIER_CHECK=1; skipping identifier-retirement check"
fi

# ============================================================================
# CHECK J: tech-debt surface advisory (ADVISORY — NEVER blocks the commit; H21-sister automation)
# When staged files touch a surface tracked in an OPEN TECH_DEBT entry, surface the overlapping
# items so debt is managed without a standing manual scan (mechanizes /readiness Check 25). The
# DECISION stays human: subsume / adjacent / defer (feedback_opportunistic_tech_debt_closure).
# (Check I is reserved for the calls_graph orphan-guard, TECH_DEBT-151 #8.)
# ============================================================================
if [ "${SKIP_TECH_DEBT_CHECK:-0}" != "1" ]; then
    TD_TOOL="${REPO_ROOT}/tools/check_tech_debt.py"
    [ -f "$TD_TOOL" ] && python3 "$TD_TOOL" --staged 2>&1 || true   # advisory: surfaces matches, never fails
fi

# ============================================================================
# CHECK K: struct layout-safety guard (TECH_DEBT-157 + D-202 — Knight/H21/H9/H12-class structural guard)
# (a) An alignas(>16) struct allocated via bare malloc/calloc/realloc lands MISALIGNED (16B, not the
#     required 64B) → member access is UB + aligned-SIMD/false-sharing isolation silently break. The
#     normal -O3 build tolerates it; only a sanitizer (or a real AVX-512 aligned op) trips on it.
# (c) A byte-serialized type (fwrite/fread/memcmp/SHA/HMAC) with NO static_assert(sizeof(T)==N) → a silent
#     layout change is a wire/persist break (H9/H12) instead of a compile error. The cascade-impact guard.
# Fires when a staged source file could introduce either. Tool: tools/check_struct_alignment.py.
# ============================================================================
if [ "${SKIP_ALIGNMENT_CHECK:-0}" != "1" ]; then
    AL_TOOL="${REPO_ROOT}/tools/check_struct_alignment.py"
    STAGED_AL=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(hpp|cpp|h)$' || true)
    if [ -n "$STAGED_AL" ] && [ -f "$AL_TOOL" ]; then
        echo "[pre-commit] Check K: struct layout-safety guard (over-aligned alloc + byte-serialized size-pin coverage)"
        AL_OUT=$(python3 "$AL_TOOL" 2>&1); AL_RC=$?
        echo "$AL_OUT" | tail -8
        if [ "$AL_RC" -ne 0 ]; then
            echo "[pre-commit] Check K FAIL: (a) an alignas(>16) struct via bare malloc/calloc/realloc (misaligned = UB), OR (c) a byte-serialized type with no static_assert(sizeof(T)==N) (silent wire/persist break). See the tool output above."
            echo "[pre-commit]   (a) use aligned_alloc(alignof(T), sizeof(T)) / posix_memalign / C++17 \`new T\`; (c) add static_assert(sizeof(T)==<N>) co-located + bump the snapshot VERSION (H21) — OR bypass with SKIP_ALIGNMENT_CHECK=1"
            OVERALL_FAIL=1
        else
            echo "[pre-commit] Check K PASS"
        fi
    fi
fi

# ============================================================================
# Overall exit
# ============================================================================
if [ "$OVERALL_FAIL" = "1" ]; then
    echo ""
    echo "[pre-commit] BLOCKED: one or more CI checks failed."
    exit 1
fi

exit 0
